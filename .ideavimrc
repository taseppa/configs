let mapleader = " "

:set showcmd
:set ignorecase
:set smartcase
set commentary
set surround
set hlsearch
set incsearch
set whichwrap+=<,>,h,l,[,]
set highlightedyank
set nerdtree
set clipboard+=unnamed

nnoremap <Tab> >>_
nnoremap <S-Tab> <<_
inoremap <S-Tab> <C-D>
vnoremap <Tab> >gv
vnoremap <S-Tab> <gv

" Jump between methods
nmap [[ <Action>(MethodUp)
nmap ]] <Action>(MethodDown)

" Open NERDTree (use q to exit)
map <leader>e :NERDTreeFind<CR>
map <leader>E :NERDTreeFocus<CR>

" Window splits
map <leader>wv <Action>(SplitVertically)
map <leader>ws <Action>(SplitHorizontally)
map <leader>wu <Action>(Unsplit)
map <leader>wm <Action>(MoveEditorToOppositeTabGroup)

" Display options
map <leader>ud <Action>(ToggleDistractionFreeMode)
map <leader>uz <Action>(ToggleZenMode)
map <leader>uf <Action>(ToggleFullScreen)

" File navigation
map <leader>ff <Action>(GotoFile)
map <leader>fr <Action>(RecentFiles)
map <leader>fc <Action>(FindInPath)
map <leader><leader> <Action>(RecentFiles)
map <leader>, <Action>(GotoFile)
map <leader>. <Action>(FindInPath)
map <leader>fl <Action>(RecentLocations)
map <leader>fs <Action>(NewScratchFile)

" Code Actions
nmap <leader>cd <Action>(ShowErrorDescription)
nmap <leader>cr <Action>(RenameElement)

" Line Diagnostics
nmap ]d <Action>(GotoNextError)
nmap [d <Action>(GotoPreviousError)

" Go to code
nmap gd <Action>(GotoDeclaration)
nmap gy <Action>(GotoTypeDeclaration)
nmap gi <Action>(GotoImplementation)
nmap gr <Action>(ShowUsages)
nmap gt <Action>(GotoTest)
nmap gf <Action>(Back)
nmap gb <Action>(Forward)


nnoremap <C-W>n :action SplitVertically<CR>
nnoremap <C-W>q :action CloseEditor<CR>
nnoremap <CR> :noh<CR>
map <leader>a :action EditorCodeBlockStart<CR>
map <leader>b :action FindUsagesInFile<CR>
"map <leader>c :action $Copy<CR>
map <leader>d :action ShowErrorDescription<CR>
" map <leader>e :action RecentFiles<CR>
map <leader>f :action Find<CR>
map <leader>g :action GotoDeclaration<CR>
map <leader>h :action TypeHierarchy<CR>
" map <leader>i :action GotoImplementation<CR>
map <leader>m :action EditorScrollToCenter<CR>
map <leader>n :action GotoNextError<CR>
map <leader>o :action OverrideMethods<CR>
map <leader>p :action ParameterInfo<CR>
"map <leader>q :action QuickJavaDoc<CR>
map <leader>r :action Replace<CR>
nnoremap <leader>q :source ~/.ideavimrc<CR>
map <leader>s :action SaveAll<CR>
map <leader>t :action JS.TypeInfo<CR>
map <leader>u :action GotoSuperMethod<CR>
map <leader>v :action $Paste<CR>
map <leader>w :action EditorSelectWord<CR>
map <leader>x :action $Cut<CR>
map <leader>y :action EditorDeleteLine<CR>
map <leader>[ :action EditorCodeBlockStart<CR>
map <leader>] :action EditorCodeBlockEnd<CR>

" set selectmode=mouse,key,cmd,ideaselection
map <leader>z :action ShowErrorDescription<CR>

